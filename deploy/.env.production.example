# Copy to .env.production (never commit it) and replace every value. scripts/check_release_env.py
# refuses to release while a placeholder, a published local default, or a short secret remains.

TSELA_DOMAIN=example.com
ACME_EMAIL=you@example.com

# Public URL of the identity provider (GoTrue) and the secret shared with the API.
AUTH_PUBLIC_URL=https://auth.example.com
AUTH_JWT_SECRET=generate-64-random-characters-here
AUTH_DB_PASSWORD=generate-a-strong-password

TOKEN_HASH_SECRET=generate-at-least-32-random-bytes
DOCS_SANDBOX_API_KEY=tos_live_generate_a_unique_sandbox_key_here
GRAFANA_WEBHOOK_SECRET=generate-a-random-secret
GRAFANA_ADMIN_PASSWORD=generate-a-strong-password

POSTGRES_PASSWORD=generate-a-strong-password
REPLICATION_PASSWORD=generate-a-strong-password
BACKUP_DB_PASSWORD=generate-a-strong-password
BACKUP_ENCRYPTION_PASSPHRASE=generate-48-random-characters-and-store-a-copy-offline

MINIO_ROOT_USER=choose-a-user
MINIO_ROOT_PASSWORD=generate-a-strong-password
UPLOADS_ACCESS_KEY=choose-a-key
UPLOADS_SECRET_KEY=generate-a-strong-secret
BACKUPS_ACCESS_KEY=choose-a-different-key
BACKUPS_SECRET_KEY=generate-a-different-secret
OBJECT_STORE_PUBLIC_ENDPOINT=https://objects.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Optional: turn on only after creating the Google OAuth client with exact callback URLs.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
