# IDE files
*.iml
/.idea/
/.vscode/

# OS files
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# JavaScript applications
/web/node_modules/
/web/.next/
/admin/node_modules/
/admin/.next/
/marketing/node_modules/
/marketing/.next/
/rider/node_modules/
/rider/.next/
/docs-site/node_modules/
/docs-site/.next/

# Legacy applications retained only in Git history
/dashboard/node_modules/
/dashboard/dist/
/dashboard/.env

# Recovery and release evidence stays local; the records are copied into the launch record.
/ops/backups/evidence/*.json
/deploy/records/
/deploy/.current-version

# MapLibre worker copied from node_modules by scripts/copy-maplibre-worker.mjs
/rider/public/maplibre/
/admin/public/maplibre/
